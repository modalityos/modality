#!/bin/sh
# ModalityOS (KWin): KWin standalone with a terminal, until the Shell joins the Session.
# Closing the terminal ends the Session, and greetd brings the Greeter back.
set -eu

for terminal in konsole foot alacritty kitty xterm; do
    if command -v "$terminal" >/dev/null 2>&1; then
        break
    fi
    terminal=""
done

if [ -z "$terminal" ]; then
    echo "modalityos-session-kwin: no terminal found (konsole, foot, alacritty, kitty, xterm)" >&2
    exit 1
fi

exec dbus-run-session -- kwin_wayland_wrapper --xwayland --exit-with-session="$(command -v "$terminal")"
