# Local edits are marked "ModalityOS:".

### ArchLinuxPackages ###
*.tar
*.tar.*
*.jar
*.exe
*.msi
*.zip
*.tgz
*.log
*.log.*
*.sig

# ModalityOS: makepkg's pkg/ and src/ scoped to packaging, so crate src/ dirs stay tracked.
/packaging/arch/**/pkg/
/packaging/arch/**/src/

### Linux ###
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

### QML ###
# Cached binary representations of QML and JS files
*.qmlc
*.jsc

### Qt ###
# C++ objects and libs
*.slo
*.lo
*.o
*.a
*.la
*.lai
*.so
*.so.*
*.dll
*.dylib

# Qt-es
object_script.*.Release
object_script.*.Debug
*_plugin_import.cpp
/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
# ModalityOS: dropped `Makefile*` and `*build-*`; they would hide files such as tools/build-iso.sh.
*.qm
*.prl

# Qt unit tests
target_wrapper.*

# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database
compile_commands.json

# QtCreator local machine specific files for imported projects
*creator.user*

*_qmlcache.qrc

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# ModalityOS: Cargo.lock is committed; the workspace builds binaries and CI uses --locked.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### rust-analyzer ###
# Can be generated by other build systems other than cargo (ex: bazelbuild/rust_rules)
rust-project.json


### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/rust,rust-analyzer,qt,qml,archlinuxpackages,linux,visualstudiocode

### ModalityOS ###
# archiso build output
/iso/work/
/iso/out/

# Local build output: rendered wallpapers, install staging
/build/

# Local settings, such as MODALITYOS_VM from just vm-create; .env.example shows them
/.env
